{
  "name": "zettelkasten-graph",
  "version": "1.0.0",
  "description": "Interactive Obsidian-style Zettelkasten neural graph & Markdown note manager, built as an embeddable ES module.",
  "type": "module",
  "main": "./dist-lib/zettelkasten.js",
  "module": "./src/lib/index.js",
  "exports": {
    ".": {
      "import": "./src/lib/index.js"
    },
    "./style.css": "./src/lib/zettelkasten.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "jszip": "^3.10.1",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  }
}
